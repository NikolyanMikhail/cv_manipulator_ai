<?xml version="1.0"?>
<robot name="open_manipulator_x">
  <link name="world" />
  <joint name="world_fixed" type="fixed"><origin rpy="0 0 0" xyz="0 0 0" /><parent link="world" /><child link="link1" /></joint>

  <link name="link1">
    <visual><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link1.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link1.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="3.087e-04 0 -1.217e-04" /><mass value="7.911e-02" /><inertia ixx="1.25e-05" ixy="0" ixz="-1.78e-07" iyy="2.18e-05" iyz="0" izz="1.92e-05" /></inertial>
  </link>
  <gazebo reference="link1"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="joint1" type="revolute"><parent link="link1" /><child link="link2" /><origin rpy="0 0 0" xyz="0.012 0 0" /><axis xyz="0 0 1" /><limit effort="1000" lower="-3.14" upper="3.14" velocity="4.8" /></joint>
  <link name="link2">
    <visual><origin rpy="0 0 0" xyz="0 0 0.019" /><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link2.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><origin rpy="0 0 0" xyz="0 0 0.019" /><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link2.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="-3.018e-04 5.404e-04 0.047" /><mass value="9.84e-02" /><inertia ixx="3.45e-05" ixy="0" ixz="0" iyy="3.26e-05" iyz="0" izz="1.88e-05" /></inertial>
  </link>
  <gazebo reference="link2"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="joint2" type="revolute"><parent link="link2" /><child link="link3" /><origin rpy="0 0 0" xyz="0 0 0.0595" /><axis xyz="0 1 0" /><limit effort="1000" lower="-1.5" upper="1.5" velocity="4.8" /></joint>
  <link name="link3">
    <visual><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link3.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link3.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="1.03e-02 3.77e-04 0.101" /><mass value="1.385e-01" /><inertia ixx="3.3e-04" ixy="0" ixz="-3.85e-05" iyy="3.42e-04" iyz="0" izz="6.03e-05" /></inertial>
  </link>
  <gazebo reference="link3"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="joint3" type="revolute"><parent link="link3" /><child link="link4" /><origin rpy="0 0 0" xyz="0.024 0 0.128" /><axis xyz="0 1 0" /><limit effort="1000" lower="-1.5" upper="1.4" velocity="4.8" /></joint>
  <link name="link4">
    <visual><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link4.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link4.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="0.09 0 0" /><mass value="0.132" /><inertia ixx="3.06e-05" ixy="0" ixz="0" iyy="2.42e-04" iyz="0" izz="2.51e-04" /></inertial>
  </link>
  <gazebo reference="link4"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="joint4" type="revolute"><parent link="link4" /><child link="link5" /><origin rpy="0 0 0" xyz="0.124 0 0" /><axis xyz="0 1 0" /><limit effort="1000" lower="-1.7" upper="1.97" velocity="4.8" /></joint>
  <link name="link5">
    <visual><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link5.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/link5.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="0.044 0 0.008" /><mass value="0.143" /><inertia ixx="8.08e-05" ixy="0" ixz="0" iyy="7.59e-05" iyz="0" izz="9.31e-05" /></inertial>
  </link>
  <gazebo reference="link5"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="gripper_left_joint" type="prismatic"><parent link="link5" /><child link="gripper_left_link" /><origin rpy="0 0 0" xyz="0.0817 0.021 0" /><axis xyz="0 1 0" /><limit effort="1000.0" lower="-0.05" upper="0.05" velocity="4.8" /></joint>
  <link name="gripper_left_link">
    <visual><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/gripper_left_palm.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/gripper_left_palm.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="0 0 0" /><mass value="0.1" /><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05" /></inertial>
  </link>
  <gazebo reference="gripper_left_link"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="gripper_right_joint" type="prismatic"><parent link="link5" /><child link="gripper_right_link" /><origin rpy="0 0 0" xyz="0.0817 -0.021 0" /><axis xyz="0 -1 0" /><limit effort="1000.0" lower="-0.05" upper="0.05" velocity="4.8" /></joint>
  <link name="gripper_right_link">
    <visual><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/gripper_right_palm.stl" scale="0.001 0.001 0.001" /></geometry></visual>
    <collision><geometry><mesh filename="package://open_manipulator_description/meshes/open_manipulator_x/gripper_right_palm.stl" scale="0.001 0.001 0.001" /></geometry></collision>
    <inertial><origin xyz="0 0 0" /><mass value="0.1" /><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05" /></inertial>
  </link>
  <gazebo reference="gripper_right_link"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="end_effector_joint" type="fixed"><parent link="link5" /><child link="end_effector_link" /><origin rpy="0 0 0" xyz="0.126 0 0" /></joint>
  <link name="end_effector_link">
    <inertial><origin xyz="0 0 0" /><mass value="0.001" /><inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06" /></inertial>
  </link>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.04 0.02"/></geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="link5"/>
    <child link="camera_link"/>
    <origin xyz="0.08 0.0 0.10" rpy="0 0.9 0"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Blue</material>
    <sensor name="hand_camera" type="camera">
      <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.01</near><far>10</far></clip></camera>
      <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
      <topic>/camera/image_raw</topic> 
    </sensor>
  </gazebo>

  <gazebo reference="gripper_left_link">
    <mu1>100.0</mu1> 
    <mu2>100.0</mu2>
    <kp>10000.0</kp>   
    <kd>1.0</kd>       
    <minDepth>0.005</minDepth> 
    <maxVel>0.0</maxVel>
  </gazebo>

  <gazebo reference="gripper_right_link">
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <kp>10000.0</kp>   
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <maxVel>0.0</maxVel>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint1</joint_name><topic>/joint1_cmd</topic><p_gain>200.0</p_gain><d_gain>10.0</d_gain></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint2</joint_name><topic>/joint2_cmd</topic><p_gain>200.0</p_gain><d_gain>10.0</d_gain></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint3</joint_name><topic>/joint3_cmd</topic><p_gain>200.0</p_gain><d_gain>10.0</d_gain></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>joint4</joint_name><topic>/joint4_cmd</topic><p_gain>200.0</p_gain><d_gain>10.0</d_gain></plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_left_joint</joint_name>
      <topic>/gripper_left_joint_cmd</topic>
      <p_gain>10000.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>50.0</d_gain>
      <cmd_max>1000.0</cmd_max>
      <cmd_min>-1000.0</cmd_min>
    </plugin>
    
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_right_joint</joint_name>
      <topic>/gripper_right_joint_cmd</topic>
      <p_gain>10000.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>50.0</d_gain>
      <cmd_max>1000.0</cmd_max>
      <cmd_min>-1000.0</cmd_min>
    </plugin>
  </gazebo>
</robot>