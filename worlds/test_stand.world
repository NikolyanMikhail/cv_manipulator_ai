<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="test_stand">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose></light>

    <model name="red_cube">
      <pose>0.25 -0.02 0.02 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>0.18 0.0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_sphere">
      <pose>0.25 0.08 0.02 0 0 0</pose>
      <link name="link">
        <visual name="vis"><geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>